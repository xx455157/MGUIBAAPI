## 參考範例（本專案實際程式碼）

### 範例 1：MdApiMessage 類 CRUD API

```csharp
[HttpPost("insert")]
public MdApiMessage Insert([FromBody] MdPayment_i paymentData)
{
    try
    {
        if (paymentData == null)
            return HttpContext.Response.InsertFailed(new Exception("請提供收款資料"));

        var _data = new GUIStd.DAL.OA.Models.Private.OA24.MdOA24_i { ... };
        var _result = BlOA20.InsertPayment(_data, ControlName);

        if (!_result.Success)
            return HttpContext.Response.InsertFailed(new Exception(_result.Message));

        return HttpContext.Response.InsertSuccess(_result.Seq, responseData: _result.Seq.ToString());
    }
    catch (Exception ex)
    {
        return HttpContext.Response.InsertFailed(ex);
    }
}
```

### 範例 2：anonymous object 類查詢 API

```csharp
[HttpPost("query/pages/{pageNo}")]
public IActionResult GetContracts([FromBody] MdContract_q queryParams, [DARange(1, int.MaxValue)] int pageNo)
{
    try
    {
        var _result = BlOA20.GetData(...);
        if (_result == null)
            return Ok(new { success = true, data = new { codes = new List<object>(), paging = new { totalRows = 0, rowsPerPage = 0, currentPage = pageNo } } });

        return Ok(new { success = true, data = _result });
    }
    catch (Exception ex)
    {
        return StatusCode(500, new { success = false, message = ex.Message });
    }
}
```

