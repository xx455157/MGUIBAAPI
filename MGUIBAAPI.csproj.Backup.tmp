    <Configurations>Debug;Release;Azure</Configurations>
    <AssemblyVersion>26.3.3101.0</AssemblyVersion>
    <FileVersion>26.3.3101.0</FileVersion>
    <Version>26.3.3101.0</Version>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DocumentationFile>bin\netcoreapp2.2\MGUIBAAPI.xml</DocumentationFile>
    <OutputPath>bin\</OutputPath>
    <NoWarn>1701;1702;1591</NoWarn>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <OutputPath>bin\</OutputPath>
