    <Description>GoldenUp Mobile Business Analysis WebAPI</Description>
    <NeutralLanguage>English (United States)</NeutralLanguage>
    <AssemblyName>MGUIBAAPI</AssemblyName>
    <RootNamespace>MGUIBAAPI</RootNamespace>
    <IsServiceFabricServiceProject>True</IsServiceFabricServiceProject>
    <DockerDefaultTargetOS>Windows</DockerDefaultTargetOS>
    <UserSecretsId>3D029402-1EE8-4C38-BD56-E15558D6C559</UserSecretsId>
